# ── Database ─────────────────────────────────────────────────────────────
# The API connects as a NON-superuser so Postgres RLS applies (defence in depth).
DATABASE_URL=postgres://eof_app:eof_app_pw@localhost:5432/eyeonfat
# Migrations/seeds run as the owner role.
DATABASE_ADMIN_URL=postgres://eof_owner:eof_owner_pw@localhost:5432/eyeonfat

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# 32+ char secrets. Rotate via vault in production — never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min!!
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min!
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ── Model Gateway (packages/model-gw) ────────────────────────────────────
# Leave keys empty to run the deterministic DEMO engine (fully demoable, no LLM).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default model binding when live (must exist in model_registry):
MODEL_DEFAULT=claude-sonnet-4-5

# ── FX ───────────────────────────────────────────────────────────────────
# 'seed' uses the seeded daily table; 'openexchangerates' pulls live daily.
FX_SOURCE=seed
OPENEXCHANGERATES_APP_ID=

# ── Web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Eye on Fat
# apps/web proxies /api/* to this URL (see next.config.mjs)
API_PROXY_TARGET=http://localhost:4000
