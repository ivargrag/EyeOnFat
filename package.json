{
  "name": "eyeonfat",
  "private": true,
  "version": "1.0.0",
  "description": "Eye on Fat — Cost Transformation SaaS · EMIRLabs.ai · Sustained Systemic Savings",
  "scripts": {
    "build": "pnpm -r --filter '!e2e' build",
    "build:packages": "pnpm --filter @eof/domain build && pnpm --filter @eof/model-gw build && pnpm --filter @eof/agents build && pnpm --filter @eof/db build",
    "pretypecheck": "pnpm build:packages",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r test",
    "dev": "pnpm --parallel --filter @eof/api --filter @eof/web dev",
    "db:migrate": "pnpm --filter @eof/db migrate",
    "db:seed": "pnpm --filter @eof/db seed",
    "db:reset": "pnpm --filter @eof/db reset",
    "gen:openapi": "pnpm --filter @eof/api gen:openapi",
    "e2e": "pnpm --filter e2e test"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
